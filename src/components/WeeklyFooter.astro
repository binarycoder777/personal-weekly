---
import { Icons } from '../../node_modules/@astrojs/starlight/components/Icons';
---
<>
  <section class="weekly-newsletter" aria-label="订阅周刊"><p>每周一封，记录值得关注的科技与产品。</p><form action="/subscribe/" method="get"><input name="email" type="email" placeholder="你的邮箱地址" aria-label="你的邮箱地址" /><button type="submit">订阅</button></form></section>
  <footer class="weekly-footer"><div class="weekly-footer-brand"><strong>BINARY WEEKLY</strong><span>独立思考 · 长期记录 · 2020 – 2026</span></div><nav aria-label="页脚导航"><div class="weekly-footer-pages"><a href="/">首页</a><a href="/archive/">归档</a><a href="/介绍/">关于</a></div><div class="weekly-footer-social"><a href="https://github.com/binarycoder777/personal-weekly" aria-label="GitHub"><svg viewBox="0 0 24 24" set:html={Icons.github}></svg></a><a href="/rss.xml" aria-label="RSS"><svg viewBox="0 0 24 24" set:html={Icons.rss}></svg></a></div></nav></footer>
</>

<style>
  .weekly-newsletter { display:grid; width:100%; max-width:70.75rem; grid-template-columns:minmax(0,1fr) minmax(24rem,27rem); gap:3rem; align-items:center; margin-inline:auto; padding:1.25rem 0; border-top:1px solid var(--weekly-line); border-bottom:1px solid var(--weekly-line); color:var(--weekly-ink); }
  .weekly-newsletter p { margin:0!important; font-family:"Songti SC",STSong,"Noto Serif SC",Georgia,serif; font-size:1rem; font-weight:700; }.weekly-newsletter form{display:grid; grid-template-columns:minmax(0,1fr) 5rem; margin:0!important}.weekly-newsletter input{min-width:0;margin:0;padding:.64rem .8rem;border:1px solid var(--weekly-line);background:var(--sl-color-black);color:var(--weekly-ink);font:inherit;font-size:.7rem}.weekly-newsletter button{margin:0;border:0;background:#f04b23;color:#fff;font-size:.75rem;font-weight:700}
  .weekly-footer { display:grid; width:100%; max-width:70.75rem; grid-template-columns:minmax(0,1fr) auto; align-items:center; margin-inline:auto; padding:1.25rem 0; color:var(--weekly-ink); }
  .weekly-footer-brand,.weekly-footer nav,.weekly-footer nav>div{display:flex;align-items:center;flex-wrap:nowrap;margin:0;padding:0}
  .weekly-footer-brand{gap:1.25rem;min-width:0}
  .weekly-footer strong{font-size:.68rem;letter-spacing:.1em;line-height:1}
  .weekly-footer span,.weekly-footer nav a{color:var(--weekly-muted);font-size:.63rem;text-decoration:none;line-height:1}
  .weekly-footer nav{gap:3rem;justify-self:end}
  .weekly-footer-pages,.weekly-footer-social{display:flex;align-items:center;gap:2.5rem}
  .weekly-footer-social{gap:1.25rem;margin-left:0!important}
  .weekly-footer nav a,.weekly-footer-social a{display:inline-flex;align-items:center;line-height:1}
  .weekly-footer svg{display:block;width:1rem;height:1rem;fill:currentColor}
  @media(max-width:60rem){.weekly-newsletter,.weekly-footer{padding-inline:clamp(1.25rem,4vw,2.5rem)}}
  @media(max-width:40rem){.weekly-newsletter{grid-template-columns:1fr;gap:.9rem}.weekly-footer{grid-template-columns:1fr;gap:1rem}.weekly-footer-pages{display:none}.weekly-footer nav{justify-self:start}}
</style>
