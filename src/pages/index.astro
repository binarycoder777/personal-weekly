---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LandingPage from './landPage.astro';

import PageFrame from '@astrojs/starlight/components/PageFrame.astro';
// import Header from '@astrojs/starlight/components/Header.astro';
---



<StarlightPage frontmatter={{ title: '',template:'splash' }}>
  <LandingPage />
</StarlightPage>

<style is:global>
    *, *::before, *::after {
        box-sizing: initial !important;
    }
    * {
    margin: 0 !important;
   }
  .content-panel {
    padding: 0 !important;
  }
  .content-panel .sl-container {
    width: 100% !important;
    max-width: 100% !important;
  }
</style>




