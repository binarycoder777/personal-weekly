---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LandingPage from '../components/LandingPage.astro';
---



<StarlightPage frontmatter={{
  title: '科技奇闻汇',
  description: '每周精选前沿科技、开源社区与奇趣故事，快速了解值得关注的新鲜事。',
  template: 'splash',
}}>
  <LandingPage />
</StarlightPage>

<style is:global>
  body:has(.editorial-home) {
    background: var(--weekly-bg);
  }

  /* The landing page supplies its own visible H1 and layout. */
  main > .content-panel:first-of-type {
    display: none;
  }

  main > .content-panel + .content-panel {
    padding: 0;
  }

  main > .content-panel + .content-panel > .sl-container {
    width: 100%;
    max-width: none;
    padding: 0;
  }
</style>
